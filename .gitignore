# Claude / AI assistant context — local only, never track
CLAUDE.md
.claude/
.cursor/
.aider*

# Design / implementation / planning docs — local only
/docs/
docs/*
*.design.md
*.implementation.md

# Build output
/dist/
/bin/
/build/

# Security scan output (see security-audit)
/scans/

# Go binaries / libraries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum
vendor/

# Local runtime config / secrets (a populated config is never committed)
config.yml
*.local.yml
.env
.env.*
!.env.example
*.log

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
